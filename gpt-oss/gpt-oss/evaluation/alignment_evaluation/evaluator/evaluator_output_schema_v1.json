{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow-alignment-evaluation-v1",
  "title": "Workflow alignment evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "rubric_version",
    "requirement_results",
    "dimension_scores",
    "overall_label",
    "critical_error",
    "primary_error_type",
    "confidence",
    "justification"
  ],
  "properties": {
    "task_id": {"type": "string", "pattern": "^T[0-9]+$"},
    "rubric_version": {"const": "1.0"},
    "requirement_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "status", "evidence", "confidence"],
        "properties": {
          "requirement_id": {"type": "string", "pattern": "^R[0-9]+$"},
          "status": {"enum": ["satisfied", "partially_satisfied", "not_satisfied", "insufficient_evidence"]},
          "evidence": {"type": "string", "minLength": 1, "maxLength":500},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "dimension_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_interpretation", "tool_selection", "tool_arguments", "execution", "artifact_quality", "final_response_faithfulness"],
      "properties": {
        "request_interpretation": {"type": "integer", "minimum": 0, "maximum": 2},
        "tool_selection": {"type": "integer", "minimum": 0, "maximum": 2},
        "tool_arguments": {"type": "integer", "minimum": 0, "maximum": 2},
        "execution": {"type": "integer", "minimum": 0, "maximum": 2},
        "artifact_quality": {"type": "integer", "minimum": 0, "maximum": 2},
        "final_response_faithfulness": {"type": "integer", "minimum": 0, "maximum": 2}
      }
    },
    "overall_label": {"enum": ["FULLY_SUCCESSFUL", "PARTIALLY_SUCCESSFUL", "FAILED"]},
    "critical_error": {"type": "boolean"},
    "primary_error_type": {
      "enum": ["none", "request_misinterpretation", "wrong_tool", "missing_parameter", "incorrect_parameter", "execution_failure", "missing_artifact", "invalid_artifact", "wrong_output_location", "misleading_final_response", "insufficient_evidence", "other"]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "justification": {"type": "string", "minLength": 1, "maxLength": 1000}
  }
}
